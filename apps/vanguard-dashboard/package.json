{
	"name": "vanguard-dashboard",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Vanguard Working Group",
	"type": "module",
	"scripts": {
		"build": "pnpm router:build",
		"docker:build": "docker build --tag vanguard-dashboard --file Dockerfile ../../.",
		"docker:run": "docker run -d -p 3101:3101 --env-file .env vanguard-dashboard",
		"docker:run:sh": "docker run -it --rm vanguard-dashboard sh",
		"doctor": "pnpx react-doctor@latest",
		"router:build": "react-router build",
		"router:dev": "react-router dev",
		"router:start": "react-router-serve ./build/server/index.js",
		"router:typecheck": "react-router typegen && tsc"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@gsap/react": "2.1.2",
		"@mingcute/react": "1.4.1",
		"@react-router/node": "8.2.0",
		"@react-router/serve": "8.2.0",
		"@vanguard/api-contracts": "workspace:*",
		"@vanguard/ui": "workspace:*",
		"@vanguard/ui-charts": "workspace:*",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"gsap": "3.15.0",
		"i18next": "26.3.5",
		"isbot": "5.2.0",
		"react": "19.2.7",
		"react-contenteditable": "3.3.7",
		"react-dom": "19.2.7",
		"react-i18next": "17.0.9",
		"react-router": "8.2.0",
		"recharts": "3.9.2",
		"swr": "2.4.2",
		"tailwind-merge": "3.6.0",
		"ts-pattern": "5.9.0"
	},
	"devDependencies": {
		"@react-router/dev": "8.2.0",
		"@tailwindcss/vite": "4.3.2",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"tailwind-animations": "1.0.1",
		"tailwindcss": "4.3.2",
		"typescript": "7.0.2",
		"vite": "8.1.3"
	},
	"packageManager": "pnpm@11.6.0"
}
