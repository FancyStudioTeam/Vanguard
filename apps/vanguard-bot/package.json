{
	"name": "vanguard-client",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Vanguard Working Group",
	"type": "module",
	"imports": {
		"#bot/*": "./dist/bot/*",
		"#managers/*": "./dist/managers/*",
		"#lib/*": "./dist/lib/*",
		"#utils/*": "./dist/utils/*"
	},
	"scripts": {
		"prebuild": "pnpm premove",
		"build": "pnpm vanguard:build",
		"docker:build": "docker build --tag vanguard-client --file Dockerfile ../../.",
		"docker:run": "docker run -d --env-file .env vanguard-client",
		"docker:run:sh": "docker run -it --rm vanguard-client sh",
		"premove": "premove dist",
		"vanguard:build": "tsc --project tsconfig.json",
		"vanguard:dev": "cross-env NODE_ENV=development tsx --watch src/index.ts",
		"vanguard:start": "cross-env NODE_ENV=production node dist/index.js"
	},
	"dependencies": {
		"@discordeno/bot": "22.0.1-next.9eb5642",
		"@vanguard/discord-config": "workspace:*",
		"@vanguard/discord-handlers": "workspace:*",
		"@vanguard/discord-jsx": "workspace:*",
		"@vanguard/shared-logger": "workspace:*",
		"@vanguard/shared-typeorm": "workspace:*",
		"ioredis": "5.11.1",
		"pg": "8.22.0",
		"reflect-metadata": "0.2.2",
		"typeorm": "1.1.0"
	},
	"devDependencies": {
		"@types/node": "26.1.1",
		"cross-env": "10.1.0",
		"premove": "4.0.0",
		"tsx": "4.23.1",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.6.0"
}
