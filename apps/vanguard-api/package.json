{
	"author": "Vanguard Working Group",
	"dependencies": {
		"@discordeno/utils": "21.0.0",
		"@discordjs/rest": "2.6.1",
		"@fastify/cookie": "11.0.2",
		"@fastify/cors": "11.2.0",
		"@fastify/csrf-protection": "8.0.0",
		"@fastify/helmet": "13.0.2",
		"@fastify/secure-session": "8.3.0",
		"@nestjs/cache-manager": "3.1.2",
		"@nestjs/common": "11.1.26",
		"@nestjs/core": "11.1.26",
		"@nestjs/jwt": "11.0.2",
		"@nestjs/platform-fastify": "11.1.26",
		"@nestjs/typeorm": "11.0.1",
		"@sapphire/snowflake": "3.5.5",
		"@vanguard/api-contracts": "workspace:*",
		"@vanguard/logger": "workspace:*",
		"@vanguard/prisma": "workspace:*",
		"cache-manager": "7.2.8",
		"discord-api-types": "0.38.48",
		"dotenv": "17.4.2",
		"fastify": "5.8.5",
		"mongoose": "9.6.3",
		"pg": "8.21.0",
		"rxjs": "7.8.2",
		"ts-pattern": "5.9.0",
		"typeorm": "1.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.23",
		"@types/node": "25.9.1",
		"cross-env": "10.1.0",
		"prisma": "7.8.0",
		"rimraf": "6.1.3",
		"typescript": "6.0.3"
	},
	"imports": {
		"#common/*": "./dist/common/*",
		"#lib/*": "./dist/lib/*",
		"#modules/*": "./dist/modules/*",
		"#utils/*": "./dist/utils/*"
	},
	"license": "AGPL-3.0-only",
	"name": "vanguard-api",
	"packageManager": "pnpm@11.0.0",
	"private": true,
	"scripts": {
		"build": "pnpm nest:build",
		"docker:build": "docker build --tag vanguard-api --file Dockerfile ../../.",
		"docker:run": "docker run -d -p 3001:3001 --env-file .env vanguard-api",
		"docker:run:sh": "docker run -it --rm vanguard-api sh",
		"nest:build": "nest build",
		"nest:dev": "cross-env HOST=127.0.0.1 NODE_ENV=development nest start --watch",
		"nest:start": "cross-env HOST=0.0.0.0 NODE_ENV=production node dist/index.js",
		"prebuild": "rimraf dist",
		"prisma:format": "prisma format",
		"prisma:generate": "prisma generate",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:reset": "prisma migrate reset",
		"prisma:studio": "prisma studio"
	},
	"type": "module",
	"version": "0.1.0"
}
