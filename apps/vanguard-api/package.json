{
	"name": "vanguard-api",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Vanguard Working Group",
	"type": "module",
	"imports": {
		"#common/*": "./dist/common/*",
		"#lib/*": "./dist/lib/*",
		"#modules/*": "./dist/modules/*",
		"#utils/*": "./dist/utils/*"
	},
	"scripts": {
		"prebuild": "pnpm premove",
		"build": "pnpm nest:build",
		"docker:build": "docker build --tag vanguard-api --file Dockerfile ../../.",
		"docker:run": "docker run -d -p 3001:3001 --env-file .env vanguard-api",
		"docker:run:sh": "docker run -it --rm vanguard-api sh",
		"nest:build": "nest build",
		"nest:dev": "cross-env HOST=127.0.0.1 NODE_ENV=development nest start --watch",
		"nest:start": "cross-env HOST=0.0.0.0 NODE_ENV=production node dist/index.js",
		"premove": "premove dist"
	},
	"dependencies": {
		"@discordeno/rest": "22.0.1-next.9eb5642",
		"@discordeno/types": "22.0.1-next.9eb5642",
		"@discordeno/utils": "22.0.1-next.9832342",
		"@discordjs/rest": "2.6.3",
		"@fastify/cookie": "11.1.2",
		"@fastify/cors": "11.3.0",
		"@fastify/csrf-protection": "8.0.0",
		"@fastify/helmet": "13.1.0",
		"@fastify/multipart": "10.1.0",
		"@fastify/secure-session": "8.3.0",
		"@nestjs/cache-manager": "3.1.3",
		"@nestjs/common": "11.1.28",
		"@nestjs/core": "11.1.28",
		"@nestjs/platform-fastify": "11.1.28",
		"@nestjs/schedule": "6.1.3",
		"@nestjs/typeorm": "11.0.3",
		"@sapphire/snowflake": "3.5.5",
		"@vanguard/api-contracts": "workspace:*",
		"@vanguard/shared-logger": "workspace:*",
		"@vanguard/shared-typeorm": "workspace:*",
		"cache-manager": "7.2.9",
		"discord-api-types": "0.38.51",
		"fastify": "5.10.0",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"stripe": "22.3.2",
		"ts-pattern": "5.9.0",
		"typeorm": "1.1.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.24",
		"@types/node": "26.1.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"@typescript/typescript6": "6.0.2",
		"cross-env": "10.1.0",
		"premove": "4.0.0",
		"typescript": "npm:@typescript/typescript6@6.0.2"
	},
	"packageManager": "pnpm@11.6.0"
}
