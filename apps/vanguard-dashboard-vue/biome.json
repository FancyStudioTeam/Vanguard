{
	"$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"noDuplicateClasses": "on",
				"useSortedAttributes": "on",
				"useSortedProperties": "on"
			}
		}
	},
	"css": {
		"formatter": {
			"quoteStyle": "single"
		},
		"parser": {
			"tailwindDirectives": true
		}
	},
	"extends": "//",
	"files": {
		"includes": [
			"**",
			"!!**/build"
		]
	},
	"formatter": {
		"attributePosition": "auto"
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"indentScriptAndStyle": true
		}
	},
	"linter": {
		"domains": {
			"tailwind": "all",
			"vue": "all"
		},
		"rules": {
			"correctness": {
				"useImportExtensions": {
					"level": "error",
					"options": {
						"forceJsExtensions": false
					}
				}
			},
			"nursery": {
				"useSortedClasses": {
					"fix": "safe",
					"level": "error",
					"options": {
						"attributes": [
							"class",
							"className"
						],
						"functions": [
							"class",
							"className",
							"cva",
							"twMerge"
						]
					}
				}
			},
			"suspicious": {
				"noUnknownAtRules": "off"
			}
		}
	}
}
