{
	"name": "vanguard",
	"version": "0.1.0",
	"private": true,
	"description": "Vanguard's Official Source Code",
	"repository": {
		"type": "git",
		"url": "https://github.com/FancyStudioTeam/Vanguard"
	},
	"license": "AGPL-3.0-only",
	"author": "Vanguard Working Group",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:ci": "biome ci",
		"biome:write": "biome check --write",
		"docker:compose:build": "docker compose build",
		"docker:compose:up": "docker compose up -d",
		"prepare": "husky",
		"turbo:build": "turbo build"
	},
	"nano-staged": {
		"**/*.{js,jsx,ts,tsx,json,css}": "pnpm biome:write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/types": "21.2.0",
		"husky": "9.1.7",
		"nano-staged": "1.0.2",
		"turbo": "2.10.7",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.6.0"
}
