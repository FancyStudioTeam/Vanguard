{
	"name": "@vanguard/discord-jsx",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Vanguard Working Group",
	"type": "module",
	"imports": {
		"#interactive/*": "./dist/interactive/*",
		"#layout/*": "./dist/layout/*",
		"#utils/*": "./dist/utils/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"import": "./dist/jsx-runtime.js",
			"require": "./dist/jsx-runtime.js"
		}
	},
	"scripts": {
		"prebuild": "pnpm rimraf",
		"build": "tsgo --project tsconfig.json",
		"rimraf": "node ../../scripts/rimraf.js"
	},
	"dependencies": {
		"@discordeno/bot": "22.0.1-next.9832342"
	},
	"devDependencies": {
		"@types/node": "26.0.0",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@11.6.0"
}
