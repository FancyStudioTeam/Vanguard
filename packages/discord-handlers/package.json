{
	"name": "@vanguard/discord-handlers",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Vanguard Working Group",
	"type": "module",
	"imports": {
		"#base/*": "./dist/base/*",
		"#commands/*": "./dist/commands/*",
		"#decorators/*": "./dist/decorators/*",
		"#events/*": "./dist/events/*",
		"#messages/*": "./dist/messages/*"
	},
	"exports": {
		"./base": {
			"types": "./dist/base/index.d.ts",
			"import": "./dist/base/index.js",
			"require": "./dist/base/index.js"
		},
		"./commands": {
			"types": "./dist/commands/index.d.ts",
			"import": "./dist/commands/index.js",
			"require": "./dist/commands/index.js"
		},
		"./decorators": {
			"types": "./dist/decorators/index.d.ts",
			"import": "./dist/decorators/index.js",
			"require": "./dist/decorators/index.js"
		},
		"./events": {
			"types": "./dist/events/index.d.ts",
			"import": "./dist/events/index.js",
			"require": "./dist/events/index.js"
		}
	},
	"scripts": {
		"prebuild": "pnpm rimraf",
		"build": "tsgo --project tsconfig.json",
		"rimraf": "node ../../scripts/rimraf.js"
	},
	"dependencies": {
		"@discordeno/bot": "22.0.1-next.9832342",
		"@vanguard/discord-config": "workspace:*",
		"utility-types": "3.11.0"
	},
	"devDependencies": {
		"@types/node": "26.0.0",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@11.6.0"
}
