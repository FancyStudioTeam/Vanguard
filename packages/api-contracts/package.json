{
	"name": "@vanguard/api-contracts",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"author": "Vanguard Working Group",
	"type": "module",
	"imports": {
		"#interfaces/*": "./dist/interfaces/*",
		"#rest/*": "./dist/rest/*"
	},
	"exports": {
		"./enums": {
			"types": "./dist/enums/index.d.ts",
			"import": "./dist/enums/index.js",
			"require": "./dist/enums/index.js"
		},
		"./interfaces": {
			"types": "./dist/interfaces/index.d.ts",
			"import": "./dist/interfaces/index.js",
			"require": "./dist/interfaces/index.js"
		},
		"./rest": {
			"types": "./dist/rest/index.d.ts",
			"import": "./dist/rest/index.js",
			"require": "./dist/rest/index.js"
		}
	},
	"scripts": {
		"prebuild": "pnpm rimraf",
		"build": "tsgo --project tsconfig.json",
		"rimraf": "node ../../scripts/rimraf.js"
	},
	"devDependencies": {
		"@types/node": "25.9.3",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@11.6.0"
}
